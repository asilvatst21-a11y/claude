{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "claude/start-new-project-znnaq": false
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/gsdpq-vencimentos-cron", "schedule": "0 9 * * *" }
  ]
}
